rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || request.auth.token.role == 'ADMIN');
    }
    
    function isCashierOrAdmin() {
      return isAuthenticated();
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // 2. Categories & Products
    match /categories/{categoryId} {
      allow read: if isCashierOrAdmin();
      allow write: if isAdmin();
    }
    
    match /products/{productId} {
      allow read: if isCashierOrAdmin();
      allow create, update, delete: if isAdmin();
      // Allow atomic stock decrement by cashier during WriteBatch checkout
      allow update: if isCashierOrAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty', 'updatedAt']);
    }

    match /productCodes/{codeId} {
      allow read: if isCashierOrAdmin();
      allow write: if isAdmin();
    }

    // 3. Customers
    match /customers/{customerId} {
      allow read, write: if isCashierOrAdmin();
    }

    // 4. Sales & Invoices
    match /sales/{saleId} {
      allow read: if isCashierOrAdmin();
      allow create: if isCashierOrAdmin();
      allow update, delete: if isAdmin();
    }

    // 5. Stock Movements
    match /stockMovements/{movementId} {
      allow read, create: if isCashierOrAdmin();
      allow update, delete: if isAdmin();
    }

    // 6. Held Bills (POS Parking)
    match /heldBills/{billId} {
      allow read, write: if isCashierOrAdmin();
    }

    // 7. Daily Close & Shifts
    match /dailyCloses/{closeId} {
      allow read: if isCashierOrAdmin();
      allow create: if isCashierOrAdmin();
      allow update, delete: if isAdmin();
    }

    // 8. Invoice Counters
    match /counters/{counterId} {
      allow read, write: if isCashierOrAdmin();
    }
  }
}
